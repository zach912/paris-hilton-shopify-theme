{% layout 'theme' %}

<section class="cart-page">
  <div class="container">
    <h1 class="cart-page__title">Your Bag 💖</h1>

    {%- if cart.item_count > 0 -%}
      <div class="cart-page__layout">

        <!-- Items -->
        <div>
          {%- form 'cart', cart -%}
            <table class="cart-page__table">
              <thead>
                <tr>
                  <th colspan="2">Product</th>
                  <th>Quantity</th>
                  <th>Total</th>
                </tr>
              </thead>
              <tbody>
                {%- for item in cart.items -%}
                  <tr>
                    <td style="width:100px;padding-right:20px;">
                      <a href="{{ item.url }}">
                        {%- if item.image -%}
                          <img src="{{ item.image | image_url: width: 200 }}"
                            alt="{{ item.title }}"
                            width="100" height="100"
                            style="border-radius:var(--radius-md);object-fit:cover;">
                        {%- endif -%}
                      </a>
                    </td>
                    <td>
                      <a href="{{ item.url }}" style="font-family:var(--serif);font-size:18px;font-weight:700;">{{ item.product_title }}</a>
                      {%- if item.variant_title != blank -%}
                        <p style="font-size:14px;color:var(--gray-mid);margin-top:4px;">{{ item.variant_title }}</p>
                      {%- endif -%}
                      <p style="font-size:14px;color:var(--pink-hot);margin-top:4px;">{{ item.price | money }}</p>
                      <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0"
                         style="font-size:12px;color:var(--gray-mid);text-decoration:underline;margin-top:8px;display:inline-block;">Remove</a>
                    </td>
                    <td>
                      <div class="quantity-selector">
                        <button type="button" class="quantity-btn" data-qty-dec aria-label="Decrease">−</button>
                        <input type="number"
                          name="updates[]"
                          class="quantity-input"
                          value="{{ item.quantity }}"
                          min="0"
                          aria-label="Quantity for {{ item.title }}">
                        <button type="button" class="quantity-btn" data-qty-inc aria-label="Increase">+</button>
                      </div>
                    </td>
                    <td style="text-align:right;font-size:18px;font-weight:700;">{{ item.final_line_price | money }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>

            <div style="margin-top:24px;">
              <button type="submit" name="update" class="btn btn-secondary">Update Cart</button>
            </div>
          {%- endform -%}
        </div>

        <!-- Summary -->
        <div class="cart-summary">
          <h2 class="cart-summary__title">Order Summary</h2>

          <div class="cart-summary__row">
            <span class="cart-summary__label">Subtotal</span>
            <span class="cart-summary__value">{{ cart.total_price | money }}</span>
          </div>
          <div class="cart-summary__row">
            <span class="cart-summary__label">Shipping</span>
            <span class="cart-summary__value">
              {%- if cart.total_price >= 10000 -%}
                FREE ✨
              {%- else -%}
                Calculated at checkout
              {%- endif -%}
            </span>
          </div>

          <div class="cart-summary__total">
            <span class="cart-summary__total-label">Total</span>
            <span class="cart-summary__total-value">{{ cart.total_price | money }}</span>
          </div>

          <p style="font-size:12px;color:var(--gray-mid);margin:12px 0 16px;text-align:center;line-height:1.5;">
            Taxes calculated at checkout.
          </p>

          <a href="/checkout" class="btn btn-primary btn-lg btn-full" style="margin-bottom:12px;">
            Checkout — That's Hot 💖
          </a>
          <a href="/collections/all" class="btn btn-secondary btn-full">
            Continue Shopping
          </a>

          <!-- Trust Badges -->
          <div class="trust-badges" style="margin-top:20px;">
            <div class="trust-badge">
              <span class="trust-badge__icon">🔒</span>
              <span class="trust-badge__text">Secure Checkout</span>
            </div>
            <div class="trust-badge">
              <span class="trust-badge__icon">🚚</span>
              <span class="trust-badge__text">Free Shipping $100+</span>
            </div>
            <div class="trust-badge">
              <span class="trust-badge__icon">↩️</span>
              <span class="trust-badge__text">30-Day Returns</span>
            </div>
          </div>
        </div>

      </div>
    {%- else -%}
      <div style="text-align:center;padding:80px 0;">
        <div style="font-size:80px;margin-bottom:24px;">🛍️</div>
        <h2 style="font-family:var(--serif);font-size:36px;text-transform:uppercase;margin-bottom:16px;">Your bag is empty</h2>
        <p style="font-size:18px;color:var(--gray-mid);margin-bottom:32px;">Time to add some sparkle to your life 💖</p>
        <a href="/collections/all" class="btn btn-primary btn-lg">Shop Now ✨</a>
      </div>
    {%- endif -%}

  </div>
</section>
