<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-top">

      <!-- Brand Column -->
      <div class="footer-brand">
        <p class="footer-brand__wordmark">{{ shop.name | upcase }}</p>
        <p class="footer-brand__tagline">✦ Leave a little sparkle wherever you go ✦</p>
        <p class="footer-brand__desc">{{ section.settings.description }}</p>

        <div class="footer-social">
          {%- if section.settings.instagram != blank -%}
            <a href="{{ section.settings.instagram }}" class="footer-social__link" aria-label="Instagram" target="_blank" rel="noopener">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <circle cx="12" cy="12" r="4.5"/>
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.tiktok != blank -%}
            <a href="{{ section.settings.tiktok }}" class="footer-social__link" aria-label="TikTok" target="_blank" rel="noopener">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.77a8.16 8.16 0 0 0 4.77 1.52V6.84a4.85 4.85 0 0 1-1-.15z"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.twitter != blank -%}
            <a href="{{ section.settings.twitter }}" class="footer-social__link" aria-label="X / Twitter" target="_blank" rel="noopener">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.youtube != blank -%}
            <a href="{{ section.settings.youtube }}" class="footer-social__link" aria-label="YouTube" target="_blank" rel="noopener">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Link Columns -->
      {%- for i in (1..3) -%}
        {%- liquid
          if i == 1
            assign col_title = section.settings.col1_title
            assign col_menu = section.settings.col1_menu
          elsif i == 2
            assign col_title = section.settings.col2_title
            assign col_menu = section.settings.col2_menu
          else
            assign col_title = section.settings.col3_title
            assign col_menu = section.settings.col3_menu
          endif
        -%}
        <div class="footer-col">
          <p class="footer-col__title">{{ col_title }}</p>
          <ul class="footer-col__links">
            {%- for link in col_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}

    </div>

    <div class="footer-bottom">
      <p class="footer-bottom__copy">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Made with <span class="footer-bottom__sparkle">✨</span> by 11:11 Media.
      </p>
      <div class="footer-bottom__links">
        <a href="{{ shop.privacy_policy.url }}">Privacy Policy</a>
        <a href="{{ shop.terms_of_service.url }}">Terms</a>
        <a href="{{ shop.refund_policy.url }}">Refunds</a>
        <a href="/pages/contact">Contact</a>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Brand description",
      "default": "Paris Hilton's official store. Iconic drops, sliving essentials, and a whole lot of sparkle — made for you. 💖"
    },
    {
      "type": "header",
      "content": "Social Links"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "twitter",
      "label": "X / Twitter URL"
    },
    {
      "type": "url",
      "id": "youtube",
      "label": "YouTube URL"
    },
    {
      "type": "header",
      "content": "Column 1"
    },
    {
      "type": "text",
      "id": "col1_title",
      "label": "Column 1 title",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "col1_menu",
      "label": "Column 1 menu",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Column 2"
    },
    {
      "type": "text",
      "id": "col2_title",
      "label": "Column 2 title",
      "default": "Help"
    },
    {
      "type": "link_list",
      "id": "col2_menu",
      "label": "Column 2 menu",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Column 3"
    },
    {
      "type": "text",
      "id": "col3_title",
      "label": "Column 3 title",
      "default": "About"
    },
    {
      "type": "link_list",
      "id": "col3_menu",
      "label": "Column 3 menu",
      "default": "footer"
    }
  ]
}
{% endschema %}
