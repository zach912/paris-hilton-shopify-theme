{%- if section.settings.show_bar -%}
<div class="announcement-bar" role="banner">
  <div class="announcement-bar__content">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'message' -%}
          <span class="announcement-bar__sparkle">✦</span>
          <span>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
            {%- else -%}
              {{ block.settings.text }}
            {%- endif -%}
          </span>
          <span class="announcement-bar__sparkle">✦</span>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.show_dismiss -%}
    <button class="announcement-bar__dismiss" aria-label="Dismiss announcement">✕</button>
  {%- endif -%}
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "class": "announcement-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_bar",
      "label": "Show bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dismiss",
      "label": "Show dismiss button",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message",
          "default": "✨ Free shipping on orders over $100 — That's Hot 💖"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "✨ Free shipping on orders over $100 — That's Hot 💖"
          }
        }
      ]
    }
  ]
}
{% endschema %}
