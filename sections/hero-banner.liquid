<section class="hero section-{{ section.id }}"
  style="min-height: {{ section.settings.min_height }}px;">

  <!-- Media (image or video) -->
  <div class="hero__media">
    {%- if section.settings.video != blank -%}
      <video
        autoplay muted loop playsinline
        poster="{{ section.settings.image | image_url: width: 1800 }}">
        <source src="{{ section.settings.video }}">
      </video>
    {%- elsif section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 1800 }}"
        srcset="{{ section.settings.image | image_url: width: 900 }} 900w,
                {{ section.settings.image | image_url: width: 1200 }} 1200w,
                {{ section.settings.image | image_url: width: 1800 }} 1800w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: shop.name }}"
        loading="eager"
        fetchpriority="high">
    {%- else -%}
      <div style="position:absolute;inset:0;background:linear-gradient(135deg,#0A0A0A 0%,#2d0a1e 100%);"></div>
    {%- endif -%}
    <div class="hero__overlay"
      style="background: linear-gradient(135deg, rgba(10,10,10,{{ section.settings.overlay_opacity | divided_by: 100.0 }}) 0%, rgba(240,78,152,0.10) 100%);"></div>
  </div>

  <!-- Content -->
  <div class="container">
    <div class="hero__content"
      style="text-align: {{ section.settings.content_align }};">

      {%- if section.settings.eyebrow != blank -%}
        <p class="hero__eyebrow animate-fade-up">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h1 class="hero__title animate-fade-up-2">{{ section.settings.title }}</h1>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <p class="hero__subtitle animate-fade-up-3">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="hero__ctas animate-fade-up-3">
          <a href="{{ section.settings.button_link }}"
            class="btn btn-primary btn-lg">
            {{ section.settings.button_label }}
          </a>
          {%- if section.settings.button_2_label != blank -%}
            <a href="{{ section.settings.button_2_link }}"
              class="btn btn-white btn-lg">
              {{ section.settings.button_2_label }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_scroll_indicator -%}
    <div class="hero__scroll-indicator" aria-hidden="true">
      <span>Scroll</span>
      <svg width="16" height="24" viewBox="0 0 16 24" fill="none">
        <rect x="1" y="1" width="14" height="22" rx="7" stroke="currentColor" stroke-width="1.5"/>
        <circle cx="8" cy="7" r="2" fill="currentColor">
          <animateTransform attributeName="transform" type="translate" values="0,0;0,8;0,0"
            dur="1.8s" repeatCount="indefinite"/>
        </circle>
      </svg>
    </div>
  {%- endif -%}
</section>

<style>
  .section-{{ section.id }} .hero__content {
    {%- if section.settings.content_align == 'center' -%}
      margin: 0 auto;
    {%- endif -%}
  }
</style>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "video",
      "label": "Video URL (MP4)",
      "info": "Overrides image if set."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 55
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "New Collection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Headline",
      "default": "Leave A Little Sparkle"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Discover the latest drops from Paris Hilton — iconic, sliving, and made for you. 💖"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Shop Now ✨"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary button label"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 400,
      "max": 900,
      "step": 50,
      "unit": "px",
      "label": "Minimum height",
      "default": 700
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show scroll indicator",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
