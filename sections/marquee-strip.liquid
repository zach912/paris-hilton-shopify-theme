<div class="marquee-strip" style="background: {{ section.settings.background_color }}; color: {{ section.settings.text_color }};">
  <div class="marquee-strip__inner" aria-hidden="true">
    {%- for block in section.blocks -%}
      <span class="marquee-strip__item" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
    {%- endfor -%}
    {%- for block in section.blocks -%}
      <span class="marquee-strip__item" aria-hidden="true">{{ block.settings.text }}</span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee Strip",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F04E98"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "That's Hot ✦"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee Strip",
      "blocks": [
        { "type": "item", "settings": { "text": "That's Hot ✦" } },
        { "type": "item", "settings": { "text": "Sliving ✦" } },
        { "type": "item", "settings": { "text": "Iconic ✦" } },
        { "type": "item", "settings": { "text": "Loves It ✦" } },
        { "type": "item", "settings": { "text": "Sparkle ✦" } },
        { "type": "item", "settings": { "text": "Glam ✦" } }
      ]
    }
  ]
}
{% endschema %}
